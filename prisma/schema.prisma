// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AnnouncementType {
  EVENT
  NEWS
  ROAD_CLOSURE
  PUBLIC_WORK
  ALERT
  GENERAL
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  SENT_REAL
  SENT_SIMULATED
  BLOCKED_BY_SAFE_MODE
  FAILED
  CANCELLED
}

enum DeliveryMode {
  DEMO
  MANUAL
  SCHEDULED
}

enum DeliveryStatus {
  SUCCESS
  FAILED
}

enum AssistantTopic {
  GREETING
  ALERTS
  EVENTS
  ROAD_CLOSURES
  PUBLIC_WORKS
  NEWS
  INSTITUTIONAL
  FAQ
  DENUNCIAS
  OVERVIEW
  OUT_OF_SCOPE
  UNKNOWN
}

enum AssistantRoute {
  RULE_BASED
  KNOWLEDGE_BASE
  ANNOUNCEMENTS
  HYBRID_AI
  FALLBACK
}

model Segment {
  id             String        @id @default(cuid())
  name           String        @unique
  description    String?
  estimatedUsers Int           @default(0)
  recipientPhones String[]     @default([])
  announcements  Announcement[]
  deliveryLogs   DeliveryLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model CitizenContact {
  id              String   @id @default(cuid())
  phoneNumber     String   @unique
  displayName     String?
  source          String   @default("whatsapp")
  messageCount    Int      @default(0)
  lastLanguage    String?
  lastMessageType String?
  metadata        Json     @default("{}")
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  lastInboundAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([source])
}

model Announcement {
  id           String             @id @default(cuid())
  title        String
  message      String             @db.Text
  location     String?
  type         AnnouncementType
  customTypeLabel String?
  scheduledAt  DateTime
  imageUrl     String?            @db.Text
  imagePublicId String?
  imageFilename String?
  imageMimeType String?
  imageSize    Int?
  imageProvider String?
  audioUrl     String?            @db.Text
  audioPublicId String?
  audioFilename String?
  audioMimeType String?
  audioSize    Int?
  audioDuration Int?
  audioProvider String?
  status       AnnouncementStatus @default(SCHEDULED)
  sentAt       DateTime?
  segmentId    String?
  segment      Segment?           @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  deliveryLogs DeliveryLog[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, scheduledAt])
}

model CitizenReport {
  id                String               @id @default(cuid())
  title             String?
  description       String               @db.Text
  type              String               @default("general")
  category          String?
  priority          String               @default("normal")
  status            String               @default("pending")
  location          String?
  address           String?
  neighborhood      String?
  source            String               @default("whatsapp")
  reporterPhone     String?
  reporterName      String?
  whatsappMessageId String?              @unique
  whatsappFrom      String?
  whatsappRawType   String?
  images            CitizenReportImage[]
  adminNotes        String?              @db.Text
  massMessageId     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  reviewedAt        DateTime?
  resolvedAt        DateTime?

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([category, createdAt])
}

model CitizenReportImage {
  id        String        @id @default(cuid())
  reportId  String
  report    CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url       String        @db.Text
  filename  String?
  mimeType  String?
  size      Int?
  createdAt DateTime      @default(now())

  @@index([reportId])
}

model KnowledgeBaseEntry {
  id             String    @id @default(cuid())
  question       String
  answer         String    @db.Text
  questionEn     String?
  answerEn       String?   @db.Text
  shortAnswerEn  String?   @db.Text
  aliasesEn      String[]  @default([])
  tagsEn         String[]  @default([])
  translatedToEnglishAt DateTime?
  category       String
  intent         String?
  shortAnswer    String?   @db.Text
  tags           String[]  @default([])
  aliases        String[]  @default([])
  sourceUrl      String?   @db.Text
  sourceName     String?
  sourceType     String    @default("manual_admin")
  isOfficial     Boolean   @default(false)
  isActive       Boolean   @default(true)
  needsReview    Boolean   @default(false)
  confidence     Float     @default(0.7)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([category])
  @@index([intent])
  @@index([isActive])
  @@index([needsReview])
  @@index([sourceType])
}

model KnowledgeConflict {
  id         String   @id @default(cuid())
  topic      String
  category   String?
  values     Json
  sourceUrls String[] @default([])
  status     String   @default("open")
  resolution String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model DeliveryLog {
  id             String         @id @default(cuid())
  announcementId String
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  segmentId      String?
  segment        Segment?       @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  mode           DeliveryMode
  status         DeliveryStatus @default(SUCCESS)
  deliveredCount Int
  details        String?        @db.Text
  createdAt      DateTime       @default(now())

  @@index([createdAt])
}

model SchedulerRun {
  id             String    @id @default(cuid())
  source         String    @default("worker")
  startedAt      DateTime
  completedAt    DateTime?
  dueCount       Int       @default(0)
  lockedCount    Int       @default(0)
  processedCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  blockedCount   Int       @default(0)
  simulatedCount Int       @default(0)
  skippedCount   Int       @default(0)
  details        String?   @db.Text
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
}

model AssistantQueryLog {
  id            String         @id @default(cuid())
  sessionId     String
  zone          String?
  userType      String?
  userMessage   String         @db.Text
  assistantReply String        @db.Text
  detectedTopic AssistantTopic
  route         AssistantRoute
  usedOpenAI    Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([detectedTopic, createdAt])
}

model AssistantConversationMemory {
  id                     String   @id @default(cuid())
  phoneNumber            String   @unique
  sessionId              String   @unique
  status                 String   @default("open")
  history                Json     @default("[]")
  summary                String   @default("") @db.VarChar(1000)
  lastCards              Json     @default("[]")
  lastTopic              String?
  lastLanguage           String   @default("es")
  lastCategory           String?
  lastIntent             String?
  lastUserMessageAt      DateTime?
  lastAssistantMessageAt DateTime?
  lastInteractionAt      DateTime?
  followUpPromptedAt     DateTime?
  closedAt               DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status, lastInteractionAt])
  @@index([lastAssistantMessageAt])
}
